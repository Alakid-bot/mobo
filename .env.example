# 只保留必须在网页管理台启动前存在的配置。
# 所有人设、模型、记忆、情绪、限流和主动发言参数都在管理台修改。

DISCORD_TOKEN=
ADMIN_USERNAME=admin
# 至少 16 位，并包含大写、小写、数字和特殊字符。
ADMIN_PASSWORD=

# 用 `python -m app.tools generate-secrets` 生成下面两项。
SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=

DB_PATH=data/mobo.db
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
